{
  "name": "ar-timeline-view",
  "version": "1.0.5",
  "description": "A web-based timeline component for displaying and editing timelines.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/timelineview.js",
  "module": "./dist/timelineview.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/timelineview.mjs",
      "default": "./dist/timelineview.js"
    },
    "./timelineview.css": "./dist/timelineview.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/export-examples.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "version": "node scripts/update-readme-version.mjs && git add README.md",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "puppeteer": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
