{
  "name": "ar-timeline-view",
  "version": "1.2.1",
  "description": "A web-based timeline component for displaying and editing timelines.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/timelineview.js",
  "module": "./dist/timelineview.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/timelineview.mjs",
      "default": "./dist/timelineview.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.mjs"
    },
    "./timelineview.css": "./dist/timelineview.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.react.config.ts && tsc -p tsconfig.build.json && node scripts/export-examples.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && oxlint --type-aware --deny-warnings",
    "version": "node scripts/update-readme-version.mjs && git add README.md",
    "postversion": "git push --follow-tags"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
